<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App's partial Info.plist (lives outside the synchronized tldw/ folder so
	     it isn't also copied as a bundle resource). Xcode merges the generated
	     Info.plist keys (bundle name, version, …) on top of this.
	     NSAllowsLocalNetworking permits plain-HTTP loads to the Mac backend on
	     the local network (e.g. http://192.168.x.x:8100); other insecure loads
	     are still blocked by App Transport Security. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
